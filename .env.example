# Optional runtime configuration. Export values into the process environment.
# Real credentials belong in an ignored .env or a secret manager.
LM_STUDIO_BASE=http://127.0.0.1:1234/v1
LM_STUDIO_TOKEN=replace-with-local-token
ANTHROPIC_API_KEY=replace-with-provider-key
# Used by the tier-2 scorer; the CLI flag overrides it.
BENCHMARK_REPORT_EXTRACTS_DIR=test_data/cat06/synthetic-report
